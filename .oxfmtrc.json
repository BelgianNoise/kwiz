{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "printWidth": 90,
  "tabWidth": 2,
  "trailingComma": "all",
  "arrowParens": "always",
  "insertFinalNewline": true,

  "sortImports": true,
  "sortTailwindcss": true,

  "ignorePatterns": [
    "pnpm-lock.yaml",
    "data",
    "**/*.md",

    // drizzle-kit owns these: the SQL, the snapshot it diffs against, and the journal it
    // appends to. Reformatting them churns every `db:generate` and edits artifacts a tool
    // rewrites — migrations are committed and forward-only (data model §11), never touched.
    "packages/db/migrations/**"
  ]
}
