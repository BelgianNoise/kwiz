{
  "name": "kwiz",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted pub-quiz engine that runs offline on a LAN",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @kwiz/web dev",
    "build": "pnpm --filter @kwiz/web build",
    "start": "pnpm --filter @kwiz/web start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "oxlint --type-aware && pnpm lint:env",
    "lint:env": "node scripts/check-no-process-env.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @kwiz/db db:generate",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@kwiz/db": "workspace:*",
    "@kwiz/domain": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.20.0"
}
